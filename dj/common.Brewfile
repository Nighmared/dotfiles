# Microsoft Azure CLI 2.0
brew "azure-cli"
# A Kubernetes credential (exec) plugin implementing azure authentication
brew "azure/kubelogin/kubelogin", trusted: true
# User-friendly launcher for Bazel
brew "bazelisk"
# Create and run Linux containers using lightweight virtual machines
brew "container"
# Terminal JSON viewer
brew "fx"
# Command-line fuzzy finder written in Go
brew "fzf"
# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"
# Git extension for versioning large files
brew "git-lfs"
# GNU implementation of the famous stream editor
brew "gnu-sed"
# GNU Privacy Guard (OpenPGP)
brew "gnupg"
# Open source programming language to build simple/reliable/efficient software
brew "go"
# Terraform
brew "hashicorp/tap/terraform", trusted: true
# Kubernetes package manager
brew "helm@3", link: true
# Lightweight and flexible command-line JSON processor
brew "jq"
# Domain specific configuration language for defining JSON data
brew "jsonnet"
# Package manager for Jsonnet
brew "jsonnet-bundler"
# Package manager for kubectl plugins
brew "krew"
# Kubernetes command-line interface
brew "kubectl"
# Kubernetes CLI To Manage Your Clusters In Style!
brew "k9s"
# ODBC Driver for Microsoft(R) SQL Server(R)
brew "microsoft/mssql-release/msodbcsql18", trusted: true
# Sqlcmd and Bcp for Microsoft(R) SQL Server(R)
brew "microsoft/mssql-release/mssql-tools18", trusted: true
# Polyglot runtime manager (asdf rust clone)
brew "mise"
# Free (GNU) replacement for the Pico text editor
brew "nano"
# Open-source, cross-platform JavaScript runtime environment
brew "node"
# Manage multiple Node.js versions
brew "nvm"
# Search tool like grep and The Silver Searcher, AGI really likes this one
brew "ripgrep"
# Flexible, reusable and concise configuration for Kubernetes using Jsonnet
brew "tanka"
# Define your dev environment as code. For microservice apps on Kubernetes
brew "tilt"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Extremely fast Python type checker, written in Rust
brew "ty"
# Extremely fast Python package installer and resolver, written in Rust
brew "uv"
# Executes a program periodically, showing output fullscreen
brew "watch"
# Zstandard is a real-time compression algorithm
brew "zstd"

# OpenAI's official ChatGPT desktop app
cask "chatgpt"
# OpenAI's coding agent that runs in your terminal
cask "codex"
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Set of tools to manage resources and applications hosted on Google Cloud
cask "gcloud-cli"
# App to manage software development and track bugs
cask "linear"
# Team communication and collaboration software
cask "slack"
# License free Wi-Fi, VPN, and Access Application for Organizations
cask "unifi-identity-endpoint"
# Open-source code editor
cask "visual-studio-code" 
# Multimedia player
cask "vlc"
# Connect to Windows
cask "windows-app"

go "golang.org/x/tools/gopls"

krew "cnpg"
krew "ns"

npm "corepack"

tap "azure/kubelogin", "https://github.com/Azure/homebrew-kubelogin"
tap "hashicorp/tap"
tap "microsoft/mssql-release"

uv "pyflakes"
uv "ruff"

vscode "astral-sh.ty"
vscode "bazelbuild.vscode-bazel"
vscode "bradlc.vscode-tailwindcss"
vscode "charliermarsh.ruff"
vscode "dbaeumer.vscode-eslint"
vscode "detachhead.basedpyright"
vscode "esbenp.prettier-vscode"
vscode "foxundermoon.shell-format"
vscode "github.vscode-github-actions"
vscode "golang.go"
vscode "grafana.vscode-jsonnet"
vscode "hashicorp.terraform"
vscode "lextudio.restructuredtext"
vscode "ms-azuretools.vscode-containers"
vscode "ms-azuretools.vscode-docker"
vscode "ms-python.debugpy"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "ms-python.vscode-python-envs"
vscode "ms-toolsai.jupyter"
vscode "redhat.vscode-yaml"
